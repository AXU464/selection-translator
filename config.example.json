{
  "cache": {"enabled": true, "max_entries": 300},
  "api": {
    "base_url": "https://api.deepseek.com",
    "api_key": "PUT-YOUR-DEEPSEEK-API-KEY-HERE",
    "model": "deepseek-flash",
    "temperature": 0.2,
    "max_tokens": 16000,
    "thinking": false,
    "stream": true,
    "timeout_seconds": 120,
    "retries": 1,
    "extra_instructions": ""
  },
  "behavior": {
    "detect_selection": true,
    "double_click_select": true,
    "drag_threshold_px": 5,
    "min_chars": 2,
    "max_chars": 12000,
    "capture_delay_ms": 70,
    "restore_clipboard": true,
    "auto_dismiss_seconds": 9,
    "hotkey_chinese": "ctrl+alt+c",
    "hotkey_english": "ctrl+alt+e",
    "hotkey_enabled": true
  },
  "ui": {
    "theme": "system",
    "font_size": 14,
    "popup_offset": [12, 18],
    "result_on_top": false,
    "fit_to_content": true,
    "result_in_taskbar": false,
    "debug_webview": false
  },
  "logging": {
    "level": "INFO",
    "max_mb": 2,
    "backups": 3
  }
}
