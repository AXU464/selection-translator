# runtime artefacts
logs/
local-data/
.webview/
state.json
__pycache__/
*.py[cod]

# the real config holds the API key; config.example.json is the template
config.json

# personal notes / requirement draft — keep local, it may mention keys or machine details
task.txt

# development-only tooling: test suites, probes and diagnostics stay local
scripts/

# internal task/feature notes for handing work to another agent — keep local
TASKS-gpt.md

# local agent writing-style instructions — not part of the app
LANGUAGE_STYLE.md

# local test documents (paper excerpts, formula test pages …) — never publish
*.pdf
*.docx
